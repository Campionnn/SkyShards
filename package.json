{
  "name": "fusion-calculator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://skyshards.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d dist",
    "deploy:gh-pages": "cross-env GITHUB_PAGES=true pnpm run build && gh-pages -d dist",
    "deploy:surge": "pnpm run build && surge dist --domain skyshards-fusion-calculator.surge.sh",
    "deploy:netlify": "pnpm run build && netlify deploy --prod --dir dist",
    "deploy:vercel": "pnpm run build && vercel --prod"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@hookform/resolvers": "^5.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.11.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.525.0",
    "pako": "^2.2.0",
    "react": "^19.2.8",
    "react-custom-scrollbars-2": "^4.5.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.13.3",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "terser": "^5.49.0",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "7.1.5",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@10.18.1"
}
